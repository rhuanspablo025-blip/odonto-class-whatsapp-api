# Ambiente da API WhatsApp do Odonto Class.
# Copie para `.env` e preencha. NUNCA versione o `.env`.
#
# ── Separação de ambientes (NODE_ENV) ───────────────────────────────────────
# development : SQLite local + provedor de teste. Default.
# test        : execução de testes automatizados.
# staging     : homologação. Comporta-se como produção (provedor real da Meta,
#               logs JSON, sem stack traces, seed desabilitado). Para simular
#               a Meta SEM enviar de verdade, defina WHATSAPP_PROVIDER=test.
# production  : produção (faturamento direto à Meta — Opção A).
#
# Cada ambiente tem seu PRÓPRIO conjunto de credenciais e seu PRÓPRIO banco.
# Nunca reutilize App Secret, ENCRYPTION_KEY, API_KEY_PEPPER ou banco entre
# ambientes diferentes.

NODE_ENV=development
PORT=3001
LOG_LEVEL=info

# Seletor de provedor WhatsApp (opcional).
#   meta -> usa a Cloud API real (obrigatório em staging/produção com número real)
#   test -> provedor simulado (nunca envia mensagens reais)
# Se ausente: development/test usam o simulado; staging/produção usam a Meta.
WHATSAPP_PROVIDER=test

# Banco (Turso / libSQL)
#   dev local : file:./.local/dev.db
#   staging   : libsql://odontoclass-api-staging-<org>.turso.io
#   produção  : libsql://odontoclass-api-<org>.turso.io
DATABASE_URL=file:./.local/dev.db
# Token de autenticação do Turso (obrigatório em staging/produção). Deixe em
# branco apenas para arquivos locais.
DATABASE_AUTH_TOKEN=

# Meta WhatsApp Cloud API
META_GRAPH_API_VERSION=v27.0
META_ACCESS_TOKEN=
META_PHONE_NUMBER_ID=
META_WABA_ID=
# App ID/Secret do app Meta (necessários para o Embedded Signup real).
META_APP_ID=
META_APP_SECRET=
# Configuration ID do Embedded Signup (criado no painel da Meta).
META_EMBEDDED_SIGNUP_CONFIG_ID=
META_WEBHOOK_VERIFY_TOKEN=

# Segurança
# Pepper de hash das chaves de API dos consumidores (mín. 8 caracteres).
API_KEY_PEPPER=troque-por-uma-string-aleatoria-longa
# Chave base64 de 32 bytes para AES-256-GCM das credenciais por clínica.
ENCRYPTION_KEY=troque-por-chave-base64-de-32-bytes
# Token de autenticação interna (worker <-> API).
INTERNAL_WORKER_TOKEN=troque-por-token-interno
# Segredo usado para assinar o canal de eventos em tempo real (SSE).
# Se ausente, cai para INTERNAL_WORKER_TOKEN.
EVENTS_SIGNING_SECRET=

# Worker
WORKER_CONCURRENCY=4
WORKER_POLL_INTERVAL_MS=1000
